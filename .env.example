# football-data.org (https://www.football-data.org/client/register)
FOOTBALLDATA_TOKEN=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional: defaults to onboarding@resend.dev if unset.
RESEND_FROM=Barca Daily <onboarding@resend.dev>

# Recipient — the email that receives daily briefings and match recaps.
RECIPIENT_EMAIL=

# Manual trigger secret. Generate with: openssl rand -hex 32
CRON_SECRET=

# Upstash Redis — auto-injected by Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides (football-data.org IDs/codes)
BARCA_TEAM_ID=81
LALIGA_CODE=PD
UCL_CODE=CL
